# Codimente Private AI - environment template
# Copy to .env and fill in the values.

# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Local PostgreSQL ---
DB_NAME=codimente_ai
DB_USER=codimente_ai_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# On Render, DATABASE_URL is injected automatically and
# takes precedence over the individual DB_* variables.
# DATABASE_URL=

# --- AI provider (Hugging Face router) ---
HF_TOKEN=change-me
AI_MODEL=openai/gpt-oss-120b:cerebras

# --- Embeddings ---
# api   = Hugging Face Inference API (default; no torch,
#         small memory footprint)
# local = in-process sentence-transformers model for
#         on-premises/air-gapped installs; first run:
#         pip install sentence-transformers
EMBEDDINGS_BACKEND=api

# --- Static/media ---
# MEDIA_ROOT=/opt/app/media
